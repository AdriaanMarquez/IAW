# 1. Redirección HTTP a HTTPS (Requisito Fase 2)
server {
    listen 80;
    server_name docs.adrian.iaw interno.adrian.iaw;
    
    # Redirige con código 301 (Permanente). En el README justificarás que el 301 
    # es mejor para que los navegadores guarden en caché que la web ahora es segura.
    return 301 https://$host$request_uri;
}

# 2. Servidor HTTPS (Proxy Inverso y TLS)
server {
    listen 443 ssl;
    server_name docs.adrian.iaw interno.adrian.iaw;

    # Certificados que generaste antes
    ssl_certificate /etc/nginx/ssl/adrian.crt;
    ssl_certificate_key /etc/nginx/ssl/adrian.key;
    
    # Restricción a TLS 1.2 y 1.3 (Requisito Fase 2)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5; 

    location / {
        # Reenvía el tráfico al contenedor de Apache por su nombre interno
        proxy_pass http://apache-nimbus:80;
        
        # Preserva la cabecera Host original (Crucial para que Apache sepa qué web mostrar)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
